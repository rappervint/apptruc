# ===================================================================
# CẤU HÌNH TRỢ LÝ AI GOOGLE GEMINI CHO TRẦN BÌNH AUTO
# ===================================================================
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Sau khi lấy key, copy file này thành .env và dán key của bạn vào:

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cấu hình Ollama (nếu có dùng máy chủ LLM offline cục bộ):
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

